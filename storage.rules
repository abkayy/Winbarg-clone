rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidImageFile() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif']
        && request.resource.size <= 5242880; // 5MB max
    }

    function isValidFileSize(maxSize) {
      return request.resource.size <= maxSize;
    }

    // Public read access for all images
    match /{allPaths=**} {
      allow read: if true;
    }

    // Project images: authenticated upload only
    match /projects/{projectId}/{filename=**} {
      allow write: if isAuthenticated() && isValidImageFile();
    }

    // Blog cover images: authenticated upload only
    match /blogs/{blogId}/{filename=**} {
      allow write: if isAuthenticated() && isValidImageFile();
    }

    // Team member images: authenticated upload only
    match /team/{teamMemberId}/{filename=**} {
      allow write: if isAuthenticated() && isValidImageFile();
    }

    // Deny all other write access
    match /{document=**} {
      allow write: if false;
    }
  }
}
